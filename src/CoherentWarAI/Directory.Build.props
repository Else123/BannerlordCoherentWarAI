<Project>
  <!--
    Centralized build configuration. User-specific paths go in paths.props.user
    (git-ignored). Copy paths.props.user.template to paths.props.user if the
    auto-detection below does not find your Bannerlord install.
  -->
  <Import Project="paths.props.user" Condition="Exists('paths.props.user')" />

  <!-- Fallback: auto-detect a Steam Bannerlord install. -->
  <PropertyGroup Condition="'$(BannerlordPath)' == ''">
    <BannerlordPath Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord')">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordPath>
    <BannerlordPath Condition="Exists('D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord')">D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordPath>
    <BannerlordPath Condition="Exists('E:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord')">E:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordPath>
    <BannerlordPath Condition="Exists('F:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord')">F:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordPath>
  </PropertyGroup>

  <PropertyGroup>
    <BannerlordBinPath>$(BannerlordPath)\bin\Win64_Shipping_Client</BannerlordBinPath>
    <BannerlordModulesPath>$(BannerlordPath)\Modules</BannerlordModulesPath>
    <BannerlordExePath>$(BannerlordPath)\bin\Win64_Shipping_Client\Bannerlord.exe</BannerlordExePath>
    <!-- Mod Configuration Menu (MCM v5), a Steam Workshop item. -->
    <McmBinPath>$(BannerlordPath)\..\..\workshop\content\261550\2859238197\bin\Win64_Shipping_Client</McmBinPath>
  </PropertyGroup>

  <Target Name="ValidateBannerlordPath" BeforeTargets="BeforeBuild">
    <Error Condition="'$(BannerlordPath)' == ''"
           Text="Bannerlord installation path not found. Copy paths.props.user.template to paths.props.user and set BannerlordPath." />
    <Error Condition="!Exists('$(BannerlordBinPath)')"
           Text="Bannerlord bin directory not found at: $(BannerlordBinPath). Check BannerlordPath in paths.props.user." />
  </Target>
</Project>
