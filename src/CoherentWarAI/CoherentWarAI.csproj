<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{7E6B1B2A-1C4D-4F9E-9A3B-2C7D5E8F1A20}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>CoherentWarAI</RootNamespace>
    <AssemblyName>CoherentWarAI</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- Bannerlord game assemblies (paths from Directory.Build.props). Private=False: never copied. -->
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Engine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Library.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Localization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Mod Configuration Menu (MCM v5) - the in-game settings page. -->
    <Reference Include="MCMv5">
      <HintPath>$(McmBinPath)\MCMv5.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Behaviors\ChokepointMapBehavior.cs" />
    <Compile Include="Behaviors\SettingsSyncBehavior.cs" />
    <Compile Include="Settings\CoherentWarAIMcmSettings.cs" />
    <Compile Include="Behaviors\WarCoordinatorBehavior.cs" />
    <Compile Include="Behaviors\WarPostureBehavior.cs" />
    <Compile Include="Logic\ClaimPlanner.cs" />
    <Compile Include="Logic\MarshalPlanner.cs" />
    <Compile Include="Logic\StrategicPriority.cs" />
    <Compile Include="Models\CoherentArmyManagementModel.cs" />
    <Compile Include="Diagnostics\WarAiLog.cs" />
    <Compile Include="Diagnostics\WarAiStats.cs" />
    <Compile Include="Logic\ChokepointAnalyzer.cs" />
    <Compile Include="Logic\EngagementHysteresis.cs" />
    <Compile Include="Logic\GarrisonPlanner.cs" />
    <Compile Include="Logic\PosturePlanner.cs" />
    <Compile Include="Logic\TargetWeights.cs" />
    <Compile Include="Models\CoherentGarrisonModel.cs" />
    <Compile Include="Models\CoherentTargetScoreModel.cs" />
    <Compile Include="Models\CommitmentStore.cs" />
    <Compile Include="Models\SettlementNeighbors.cs" />
    <Compile Include="Settings\CoherentWarAISettings.cs" />
    <Compile Include="SubModule.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="SubModule.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Post-build: deploy into the Bannerlord Modules directory. -->
  <Target Name="CopyToBannerlord" AfterTargets="Build">
    <PropertyGroup>
      <ModOutputPath>$(BannerlordModulesPath)\CoherentWarAI</ModOutputPath>
    </PropertyGroup>
    <MakeDir Directories="$(ModOutputPath);$(ModOutputPath)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputPath)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModOutputPath)\bin\Win64_Shipping_Client" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(ProjectDir)SubModule.xml" DestinationFiles="$(ModOutputPath)\SubModule.xml" />
    <Message Text="Deployed CoherentWarAI mod to $(ModOutputPath)" Importance="high" />
  </Target>
</Project>
